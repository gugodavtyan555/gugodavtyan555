  },
  {
   "id": "1b",
   "lang": "frf",
   "text": "Bon appétit !",
   "pause": 0.3
  },
  {
   "id": "1c",
   "lang": "fr",
   "text": "Tu souhaites un bon repas à un verre vide.",
   "pause": 0.3
  },
  {
   "id": "1d",
   "lang": "fr",
   "text": "Dis plutôt :",
   "pause": 0.15
